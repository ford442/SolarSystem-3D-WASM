{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build:emcc": "bash ../build-web.sh",
    "build": "npm run build:emcc && tsc && vite build",
    "preview": "vite preview",
    "serve:mock-cdn": "node scripts/mock-asset-cdn.mjs",
    "verify:cross-origin": "node verify-cross-origin-fetch.js",
    "test:textures": "node verify-textures.js",
    "test:smoke": "playwright test",
    "test:unit": "vitest run",
    "test:scripts": "node --test \"../scripts/**/*.test.mjs\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "generate:wasm-exports": "node ../scripts/generate-wasm-exports.mjs",
    "generate:wasm-exports:check": "node ../scripts/generate-wasm-exports.mjs --check",
    "generate:planet-metadata": "node ../scripts/generate-planet-metadata.mjs",
    "generate:planet-metadata:check": "node ../scripts/generate-planet-metadata.mjs --check",
    "generate:texture-units": "node ../scripts/generate-texture-units.mjs",
    "generate:texture-units:check": "node ../scripts/generate-texture-units.mjs --check",
    "prebuild": "npm run generate:planet-metadata"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2"
  }
}
