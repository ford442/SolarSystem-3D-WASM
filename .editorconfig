root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Two-space formats
[*.{yml,yaml,json,html}]
indent_size = 2

# Trailing double space is a line break in Markdown
[*.md]
trim_trailing_whitespace = false

# Generated and vendored files keep whatever their generator writes
[{web/src/SolarSystem.d.ts,web/src/wasmBridge.exports.ts,src/3rdparty/**}]
trim_trailing_whitespace = unset
insert_final_newline = unset
indent_size = unset
