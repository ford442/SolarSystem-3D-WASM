{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ford442/SolarSystem-3D-WASM/resource/planets.catalog.schema.json",
  "title": "Solar System planet metadata catalog",
  "type": "object",
  "required": ["schemaVersion", "bodies", "scaleModes"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "sceneNote": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string" },
        "ru": { "type": "string" }
      }
    },
    "scaleModes": { "type": "object" },
    "initTagAllowlist": {
      "type": "array",
      "items": { "type": "string" }
    },
    "indexConvention": { "type": "object" },
    "bodies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "index", "kind", "displayName", "type", "facts", "orbit"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "index": { "type": "integer", "minimum": 0 },
          "kind": { "type": "string", "enum": ["star", "planet", "dwarf_planet", "satellite", "ring", "clouds"] },
          "parent": { "type": ["string", "null"] },
          "displayName": {
            "type": "object",
            "required": ["en"],
            "properties": {
              "en": { "type": "string" },
              "ru": { "type": "string" }
            }
          },
          "type": { "type": "string" },
          "facts": { "type": "object" },
          "orbit": {
            "type": "object",
            "properties": {
              "axialTiltDegrees": {
                "type": "number",
                "description": "IAU-style tilt SSOT. CatalogBody applies Rotate(Z); the Three.js companion uses the same value."
              },
              "keplerian": {
                "type": "object",
                "description": "Osculating elements for satellites (stored for the eclipse follow-up; runtime still uses circular sceneOrbitRadius until then).",
                "required": ["aKm", "e", "iDeg", "OmegaDeg", "omegaDeg", "M0Deg", "nDegPerDay"],
                "properties": {
                  "aKm": { "type": "number" },
                  "e": { "type": "number" },
                  "iDeg": { "type": "number" },
                  "OmegaDeg": { "type": "number" },
                  "omegaDeg": { "type": "number" },
                  "M0Deg": { "type": "number" },
                  "nDegPerDay": { "type": "number" }
                }
              },
              "sceneOrbitRadius": { "type": "number" },
              "orbitPlane": { "type": "string", "enum": ["xz", "xy"] },
              "initialAnomalyRad": { "type": "number" },
              "spinDegPerSimSecond": { "type": "number" },
              "yawOffsetDegrees": { "type": "number" },
              "artRollDegrees": { "type": "number" }
            }
          },
          "system": { "type": "object" },
          "assets": { "type": "object" },
          "includeInCompanion": { "type": "boolean" },
          "render": {
            "type": "object",
            "description": "Drives BodyCatalog.generated.h. Planets/dwarf planets/moons with a render block are built by CatalogBody/CatalogSatellite — no per-body C++ class. The Sun and ring geometry stay hand-maintained.",
            "properties": {
              "shaderFlags": {
                "type": "object",
                "properties": {
                  "hasNightTexture": { "type": "boolean" },
                  "hasSpecularMap": { "type": "boolean" },
                  "hasClouds": { "type": "boolean" }
                }
              },
              "ambientFactor": { "type": "number" },
              "useSphereIntersect": { "type": "boolean" },
              "artTiltXDegrees": { "type": "number", "description": "Optional extra Rotate(X) overlay (Saturn rings)." },
              "mesh": { "type": ["string", "null"], "description": "Optional non-sphere mesh path (Phobos/Deimos)." },
              "lod": {
                "type": "object",
                "properties": {
                  "diffuse": { "type": "string" },
                  "normal": { "type": "string" },
                  "specular": { "type": ["string", "null"] },
                  "night": { "type": ["string", "null"] },
                  "clouds": { "type": ["string", "null"] }
                }
              },
              "cloudLayer": {
                "type": "object",
                "description": "Optional outer-shell cloud layer (Earth/Uranus/Neptune). Not the same as shaderFlags.hasClouds.",
                "properties": {
                  "scaleFactor": { "type": "number" },
                  "diffuse": { "type": "string" },
                  "normal": { "type": "string" },
                  "spinDegPerSimSecond": { "type": "number" },
                  "ambientFactor": { "type": "number" }
                }
              }
            }
          }
        },
        "if": {
          "properties": { "kind": { "const": "satellite" } },
          "required": ["kind"]
        },
        "then": {
          "required": ["parent"],
          "properties": {
            "parent": { "type": "string", "minLength": 1 },
            "orbit": {
              "type": "object",
              "required": ["keplerian", "sceneOrbitRadius"],
              "properties": {
                "keplerian": {
                  "type": "object",
                  "required": [
                    "aKm",
                    "e",
                    "iDeg",
                    "OmegaDeg",
                    "omegaDeg",
                    "M0Deg",
                    "nDegPerDay",
                    "OmegaDotDegPerDay",
                    "omegaDotDegPerDay"
                  ]
                },
                "sceneOrbitRadius": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
